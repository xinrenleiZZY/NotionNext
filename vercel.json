{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/portfolio", "destination": "/apps/showcase", "permanent": true },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "juxingspacestation.top" }],
      "destination": "https://www.juxingspacestation.top/$1",
      "permanent": true
    }
  ],
  "headers": []
}
